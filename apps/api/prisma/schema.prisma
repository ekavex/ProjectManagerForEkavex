// Ekavist database schema.
//
// Prose rationale lives in docs/DATABASE_DESIGN.md. Rules followed throughout:
//   * ids are cuids; every table carries createdAt / updatedAt
//   * `deletedAt` exists only on Project, Task, Message, Document (decision D-010)
//   * enum values mirror packages/shared/src/enums.ts one-for-one
//   * instants are timestamptz (UTC); calendar values are @db.Date

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

enum OrgRole {
  SUPER_ADMIN
  PROJECT_LEAD
  TEAM_MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectRole {
  LEAD
  MEMBER
  VIEWER
}

enum ProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  BLOCKED
  REWORK_REQUIRED
  COMPLETED
  CANCELLED
}

enum PhaseGateStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

enum MilestoneStatus {
  PLANNED
  AT_RISK
  ACHIEVED
  MISSED
  CANCELLED
}

enum RaciRole {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  LEAVE
  ABSENT
  HOLIDAY
}

enum DocumentCategory {
  REQUIREMENTS
  DESIGN
  DEVELOPMENT
  TESTING
  REPORTS
  MEETING
  FINAL_DELIVERABLES
  OTHER
}

enum ResourceKind {
  FILE
  LINK
  GOOGLE_DRIVE
}

enum NoteVisibility {
  PROJECT
  LEADS_ONLY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
  CLOSED
  OCCURRED
}

enum IssueStatus {
  OPEN
  INVESTIGATING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChangeRequestStatus {
  REQUESTED
  IMPACT_ANALYSIS
  UNDER_REVIEW
  APPROVED
  REJECTED
  IMPLEMENTED
  WITHDRAWN
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_DUE_TODAY
  TASK_OVERDUE
  TASK_BLOCKED
  TASK_COMPLETED
  PROJECT_ASSIGNED
  PROJECT_MEMBER_ADDED
  MENTION
  MESSAGE_RECEIVED
  MESSAGE_PINNED
  PHASE_APPROVAL_REQUIRED
  PHASE_APPROVED
  PHASE_REJECTED
  CHANGE_REQUEST_CREATED
  CHANGE_REQUEST_DECIDED
  RISK_ASSIGNED
  ISSUE_ASSIGNED
  LEAD_OVERDUE_DIGEST
  DAILY_SUMMARY
  WEEKLY_SUMMARY
  LEAVE_REQUESTED
  LEAVE_DECIDED
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
}

enum ImportJobStatus {
  PARSED
  CONFIRMED
  FAILED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LessonCategory {
  WHAT_WENT_WELL
  WHAT_WENT_WRONG
  CHANGE
  REPEAT
  TECHNICAL
  PROCESS
  TEAM
}

// ===========================================================================
// Organisation and people
// ===========================================================================

/// One row per deployment today (decision D-002). Holds the settings that the rest of
/// the system must not guess: the timezone every calendar value is interpreted in, and
/// the working-day boundaries attendance is judged against.
model Organization {
  id            String   @id @default(cuid())
  name          String
  timezone      String   @default("Asia/Kolkata")
  /// Local time, HH:mm. A session started after `lateAfter` marks the day LATE.
  workdayStart  String   @default("09:30")
  lateAfter     String   @default("10:00")
  /// Minutes of work below which a day counts as HALF_DAY rather than PRESENT.
  halfDayMinutes Int     @default(240)
  fullDayMinutes Int     @default(480)
  /// Paid leave allowance per calendar year, in days, by leave type.
  annualLeaveDays Int    @default(18)
  sickLeaveDays   Int    @default(8)
  casualLeaveDays Int    @default(6)
  logoUrl       String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  users             User[]
  departments       Department[]
  projects          Project[]
  rolePermissions   RolePermission[]
  notificationRules NotificationRule[]
  holidays          Holiday[]
  leaveRequests     LeaveRequest[]
}

model Department {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  headId         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  head         User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  users        User[]       @relation("UserDepartment")
  projects     Project[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  fullName       String
  email          String
  /// Argon2id hash. Never selected into a DTO.
  passwordHash   String?
  phone          String?
  avatarUrl      String?
  departmentId   String?
  designation    String?
  role           OrgRole    @default(TEAM_MEMBER)
  status         UserStatus @default(ACTIVE)
  managerId      String?
  joiningDate    DateTime?  @db.Date
  timezone       String     @default("Asia/Kolkata")
  skills         String[]   @default([])
  lastLoginAt    DateTime?  @db.Timestamptz(3)
  /// Consecutive failed logins; reset on success. Feeds the login throttle.
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?  @db.Timestamptz(3)
  /// Base32 TOTP secret. Set while enrolment is pending, kept once confirmed.
  totpSecret     String?
  totpEnabledAt  DateTime?  @db.Timestamptz(3)
  /// SHA-256 hashes of the unused one-time recovery codes.
  totpRecoveryCodes String[] @default([])
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department   Department?  @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  manager      User?        @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      User[]       @relation("UserManager")

  headedDepartments Department[] @relation("DepartmentHead")

  notificationPreference NotificationPreference?
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]

  createdProjects   Project[]       @relation("ProjectCreatedBy")
  ledProjects       Project[]       @relation("ProjectLead")
  memberships       ProjectMember[]

  ownedPhases       Phase[]         @relation("PhaseOwner")
  approverGates     Phase[]         @relation("PhaseApprover")
  submittedGates    Phase[]         @relation("PhaseSubmittedBy")
  ownedWbsItems     WbsItem[]       @relation("WbsOwner")

  createdTasks      Task[]           @relation("TaskCreatedBy")
  accountableTasks  Task[]           @relation("TaskAccountable")
  taskAssignments   TaskAssignment[]
  taskComments      TaskComment[]
  taskAttachments   TaskAttachment[]

  ownedMilestones   Milestone[]      @relation("MilestoneOwner")
  raciAssignments   RaciAssignment[]

  attendanceDays    AttendanceDay[]      @relation("AttendanceUser")
  adjustedDays      AttendanceDay[]      @relation("AttendanceAdjustedBy")

  messages          Message[]
  messageReactions  MessageReaction[]
  messageMentions   MessageMention[]
  pinnedMessages    PinnedMessage[]

  documents         Document[]
  personalNotes     PersonalNote[]
  projectNotes      ProjectNote[]
  decisions         DecisionLog[]

  ownedRisks        Risk[]           @relation("RiskOwner")
  ownedIssues       Issue[]          @relation("IssueOwner")
  requestedChanges  ChangeRequest[]  @relation("ChangeRequester")
  analysedChanges   ChangeRequest[]  @relation("ChangeAnalyst")
  approvedChanges   ChangeRequest[]  @relation("ChangeApprover")

  notifications     Notification[]
  auditEntries      AuditLog[]
  activityEntries   ActivityLog[]
  importJobs        ImportJob[]
  lessons           ProjectLesson[]
  leaveRequests     LeaveRequest[]   @relation("LeaveRequester")
  decidedLeave      LeaveRequest[]   @relation("LeaveApprover")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([departmentId])
  @@index([managerId])
}

/// Editable mapping from an organisation role to a permission string. Seeded from
/// packages/shared/src/permissions.ts; an administrator may change it afterwards.
model RolePermission {
  id             String  @id @default(cuid())
  organizationId String
  role           OrgRole
  permission     String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, permission])
  @@index([organizationId, role])
}

model NotificationPreference {
  id                     String  @id @default(cuid())
  userId                 String  @unique
  emailOnTaskAssigned    Boolean @default(true)
  emailOnTaskDueSoon     Boolean @default(true)
  emailOnTaskOverdue     Boolean @default(true)
  emailOnMention         Boolean @default(true)
  emailOnProjectAssigned Boolean @default(true)
  emailOnPhaseDecision   Boolean @default(true)
  emailDailySummary      Boolean @default(false)
  emailWeeklySummary     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Rotating refresh tokens. Only the SHA-256 of the token is stored. `familyId` groups a
/// rotation chain so that presenting an already-rotated token revokes the whole family.
model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  familyId   String
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  /// Set when this token was exchanged for a new one.
  rotatedAt  DateTime? @db.Timestamptz(3)
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Holiday {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @db.Date
  name           String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, date])
}

// ===========================================================================
// Projects
// ===========================================================================

model Project {
  id                  String        @id @default(cuid())
  organizationId      String
  code                String
  name                String
  description         String?
  status              ProjectStatus @default(DRAFT)
  priority            Priority      @default(MEDIUM)
  /// Cached rollup of phase progress. Authoritative computation: domain/progress.ts.
  progress            Int           @default(0)
  startDate           DateTime      @db.Date
  plannedEndDate      DateTime      @db.Date
  actualStartDate     DateTime?     @db.Date
  actualEndDate       DateTime?     @db.Date
  leadId              String?
  category            String?
  client              String?
  departmentId        String?
  budget              Decimal?      @db.Decimal(18, 2)
  location            String?
  externalStakeholder String?
  logoUrl             String?
  objectives          String[]      @default([])
  deliverables        String[]      @default([])
  handoverNote        String?
  /// Completion criteria (business rule 7): what a task must carry before it can be
  /// marked completed in this project.
  completionRequiresNote        Boolean @default(false)
  completionRequiresActualHours Boolean @default(false)
  completionRequiresAttachment  Boolean @default(false)
  /// Per-project counters behind the human references T-1, R-1, I-1, CR-1, D-1.
  taskCounter         Int           @default(0)
  riskCounter         Int           @default(0)
  issueCounter        Int           @default(0)
  changeCounter       Int           @default(0)
  decisionCounter     Int           @default(0)
  createdById         String?
  archivedAt          DateTime?     @db.Timestamptz(3)
  closedAt            DateTime?     @db.Timestamptz(3)
  deletedAt           DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         User?        @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  createdBy    User?        @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  members        ProjectMember[]
  phases         Phase[]
  wbsItems       WbsItem[]
  tasks          Task[]
  dependencies   TaskDependency[]
  milestones     Milestone[]
  raci           RaciAssignment[]
  messages       Message[]
  documents      Document[]
  notes          ProjectNote[]
  decisions      DecisionLog[]
  risks          Risk[]
  issues         Issue[]
  changeRequests ChangeRequest[]
  notifications  Notification[]
  activity       ActivityLog[]
  auditEntries   AuditLog[]
  workSessions   WorkSession[]
  importJobs     ImportJob[]
  lessons        ProjectLesson[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([leadId])
  @@index([deletedAt])
}

model ProjectMember {
  id               String      @id @default(cuid())
  projectId        String
  userId           String
  projectRole      ProjectRole @default(MEMBER)
  responsibility   String?
  /// Only meaningful for a VIEWER (spec section 6.4).
  canReadChat      Boolean     @default(false)
  allocationPercent Int        @default(100)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectLesson {
  id        String         @id @default(cuid())
  projectId String
  category  LessonCategory
  note      String
  authorId  String?
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ===========================================================================
// Waterfall
// ===========================================================================

model Phase {
  id          String      @id @default(cuid())
  projectId   String
  sequence    Int
  name        String
  description String?
  ownerId     String?
  status      PhaseStatus @default(NOT_STARTED)
  progress    Int         @default(0)
  plannedStart DateTime?  @db.Date
  plannedEnd   DateTime?  @db.Date
  actualStart  DateTime?  @db.Date
  actualEnd    DateTime?  @db.Date
  deliverables String[]   @default([])

  // --- phase gate (spec section 5) ---------------------------------------
  approvalRequired Boolean         @default(false)
  gateStatus       PhaseGateStatus @default(NOT_REQUIRED)
  approverId       String?
  submittedById    String?
  submittedAt      DateTime?       @db.Timestamptz(3)
  decidedAt        DateTime?       @db.Timestamptz(3)
  decisionNote     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?   @relation("PhaseOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  approver    User?   @relation("PhaseApprover", fields: [approverId], references: [id], onDelete: SetNull)
  submittedBy User?   @relation("PhaseSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  wbsItems       WbsItem[]
  tasks          Task[]
  milestones     Milestone[]
  documents      Document[]
  notes          ProjectNote[]
  decisions      DecisionLog[]
  risks          Risk[]
  issues         Issue[]
  changeRequests ChangeRequest[]

  @@unique([projectId, sequence])
  @@index([projectId, status])
}

model WbsItem {
  id          String  @id @default(cuid())
  projectId   String
  phaseId     String?
  parentId    String?
  /// Materialised dotted path, e.g. "2.1.3". Recomputed by the service on any move.
  code        String
  /// Zero-based position among siblings; drives the code.
  position    Int     @default(0)
  /// Depth from the root, cached so the Gantt can indent without walking the tree.
  depth       Int     @default(0)
  name        String
  description String?
  ownerId     String?
  plannedStart DateTime? @db.Date
  plannedEnd   DateTime? @db.Date
  deliverable  String?
  progress     Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    Phase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  parent   WbsItem?  @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  children WbsItem[] @relation("WbsTree")
  owner    User?     @relation("WbsOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  tasks Task[]
  raci  RaciAssignment[]

  @@unique([projectId, code])
  @@index([projectId, phaseId])
  @@index([parentId])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  phaseId       String?
  wbsItemId     String?
  /// Human reference inside the project, e.g. "T-102".
  reference     String
  name          String
  description   String?
  status        TaskStatus @default(NOT_STARTED)
  priority      Priority   @default(MEDIUM)
  progress      Int        @default(0)
  startDate     DateTime?  @db.Date
  dueDate       DateTime?  @db.Date
  estimatedHours Decimal?  @db.Decimal(10, 2)
  actualHours    Decimal?  @db.Decimal(10, 2)
  accountableId String?
  createdById   String?
  completedAt   DateTime?  @db.Timestamptz(3)
  deletedAt     DateTime?  @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase       Phase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  wbsItem     WbsItem? @relation(fields: [wbsItemId], references: [id], onDelete: SetNull)
  accountable User?    @relation("TaskAccountable", fields: [accountableId], references: [id], onDelete: SetNull)
  createdBy   User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments  TaskAssignment[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  predecessors TaskDependency[] @relation("DependencySuccessor")
  successors   TaskDependency[] @relation("DependencyPredecessor")
  milestones   MilestoneTask[]
  raci         RaciAssignment[]
  documents    Document[]
  decisions    DecisionLog[]
  risks        Risk[]
  issues       Issue[]
  workSessions WorkSession[]
  notifications Notification[]

  @@unique([projectId, reference])
  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([phaseId])
  @@index([wbsItemId])
  @@index([deletedAt])
}

model TaskAssignment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  /// The first assignee; used where a single owner must be shown (Gantt, exports).
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskDependency {
  id            String         @id @default(cuid())
  projectId     String
  predecessorId String
  successorId   String
  type          DependencyType @default(FINISH_TO_START)
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  predecessor Task    @relation("DependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task    @relation("DependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([projectId])
  @@index([successorId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskAttachment {
  id        String       @id @default(cuid())
  taskId    String
  kind      ResourceKind @default(LINK)
  name      String
  url       String
  storageKey String?
  mimeType  String?
  sizeBytes Int?
  addedById String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  phaseId     String?
  name        String
  description String?
  date        DateTime        @db.Date
  status      MilestoneStatus @default(PLANNED)
  ownerId     String?
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?          @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  owner   User?           @relation("MilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  tasks   MilestoneTask[]

  @@index([projectId, date])
}

model MilestoneTask {
  milestoneId String
  taskId      String

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([milestoneId, taskId])
}

model RaciAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      RaciRole
  taskId    String?
  wbsItemId String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  wbsItem WbsItem? @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId, role])
  @@unique([wbsItemId, userId, role])
  @@index([projectId])
}

// ===========================================================================
// Attendance
// ===========================================================================

/// One row per user per calendar day, in the organisation's timezone. `workMinutes` and
/// `breakMinutes` are recomputed by the attendance service whenever a session or break
/// closes; nothing outside that service writes them.
model AttendanceDay {
  id               String           @id @default(cuid())
  userId           String
  workDate         DateTime         @db.Date
  status           AttendanceStatus @default(PRESENT)
  firstStartedAt   DateTime?        @db.Timestamptz(3)
  lastEndedAt      DateTime?        @db.Timestamptz(3)
  workMinutes      Int              @default(0)
  breakMinutes     Int              @default(0)
  adjustedById     String?
  adjustmentReason String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  user       User          @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  adjustedBy User?         @relation("AttendanceAdjustedBy", fields: [adjustedById], references: [id], onDelete: SetNull)
  sessions   WorkSession[]

  @@unique([userId, workDate])
  @@index([workDate])
}

model WorkSession {
  id              String    @id @default(cuid())
  attendanceDayId String
  userId          String
  projectId       String?
  taskId          String?
  startedAt       DateTime  @db.Timestamptz(3)
  endedAt         DateTime? @db.Timestamptz(3)
  /// Work minutes excluding breaks; written when the session closes.
  minutes         Int       @default(0)
  note            String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  attendanceDay AttendanceDay  @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  breaks        BreakSession[]

  @@index([userId, startedAt])
  @@index([attendanceDayId])
  @@index([projectId])
}

model BreakSession {
  id            String    @id @default(cuid())
  workSessionId String
  startedAt     DateTime  @db.Timestamptz(3)
  endedAt       DateTime? @db.Timestamptz(3)
  minutes       Int       @default(0)
  reason        String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  workSession WorkSession @relation(fields: [workSessionId], references: [id], onDelete: Cascade)

  @@index([workSessionId])
}

// ===========================================================================
// Chat
// ===========================================================================

model Message {
  id        String    @id @default(cuid())
  projectId String
  parentId  String?
  authorId  String
  body      String
  editedAt  DateTime? @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Message?  @relation("MessageThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Message[] @relation("MessageThread")
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  mentions    MessageMention[]
  pin         PinnedMessage?

  @@index([projectId, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model MessageAttachment {
  id         String       @id @default(cuid())
  messageId  String
  kind       ResourceKind
  name       String
  url        String
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([kind])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
}

model MessageMention {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model PinnedMessage {
  id         String   @id @default(cuid())
  messageId  String   @unique
  pinnedById String
  pinnedAt   DateTime @default(now()) @db.Timestamptz(3)

  message  Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy User    @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
}

// ===========================================================================
// Documents, notes, decisions
// ===========================================================================

model Document {
  id          String           @id @default(cuid())
  projectId   String
  phaseId     String?
  taskId      String?
  name        String
  category    DocumentCategory @default(OTHER)
  kind        ResourceKind     @default(LINK)
  url         String
  storageKey  String?
  fileType    String?
  version     String?
  description String?
  addedById   String?
  deletedAt   DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  addedBy User?   @relation(fields: [addedById], references: [id], onDelete: SetNull)

  decisions DecisionLog[]

  @@index([projectId, category])
  @@index([deletedAt])
}

/// Private to its owner. Deliberately has no projectId: a project query cannot reach it
/// even by mistake (business rule 12).
model PersonalNote {
  id         String    @id @default(cuid())
  userId     String
  title      String
  body       String    @default("")
  pinned     Boolean   @default(false)
  reminderAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ProjectNote {
  id         String         @id @default(cuid())
  projectId  String
  phaseId    String?
  authorId   String
  title      String
  body       String         @default("")
  visibility NoteVisibility @default(PROJECT)
  pinned     Boolean        @default(false)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
}

model DecisionLog {
  id               String   @id @default(cuid())
  projectId        String
  phaseId          String?
  taskId           String?
  documentId       String?
  reference        String
  title            String
  description      String?
  reason           String?
  decidedOn        DateTime @db.Date
  decisionMakerId  String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         Phase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  decisionMaker User?     @relation(fields: [decisionMakerId], references: [id], onDelete: SetNull)

  @@unique([projectId, reference])
  @@index([projectId, decidedOn])
}

// ===========================================================================
// Governance
// ===========================================================================

model Risk {
  id            String     @id @default(cuid())
  projectId     String
  phaseId       String?
  taskId        String?
  reference     String
  title         String
  description   String?
  probability   RiskLevel
  impact        RiskLevel
  /// Derived from probability x impact by domain/risk.ts. Never sent by a client.
  severity      RiskLevel
  severityScore Int
  ownerId       String?
  mitigation    String?
  contingency   String?
  status        RiskStatus @default(OPEN)
  dueDate       DateTime?  @db.Date
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  owner   User?   @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, reference])
  @@index([projectId, status])
}

model Issue {
  id               String      @id @default(cuid())
  projectId        String
  phaseId          String?
  taskId           String?
  reference        String
  title            String
  description      String?
  priority         Priority    @default(MEDIUM)
  ownerId          String?
  identifiedOn     DateTime    @db.Date
  targetResolution DateTime?   @db.Date
  status           IssueStatus @default(OPEN)
  resolution       String?
  resolvedAt       DateTime?   @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  owner   User?   @relation("IssueOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@unique([projectId, reference])
  @@index([projectId, status])
}

model ChangeRequest {
  id          String              @id @default(cuid())
  projectId   String
  phaseId     String?
  reference   String
  title       String
  description String?
  reason      String?
  status      ChangeRequestStatus @default(REQUESTED)
  requesterId String
  requestedOn DateTime            @db.Date

  // --- impact analysis ---------------------------------------------------
  scopeImpact         String?
  scheduleImpactDays  Int       @default(0)
  effortImpactHours   Decimal   @default(0) @db.Decimal(10, 2)
  resourceImpact      String?
  costImpact          Decimal?  @db.Decimal(18, 2)
  riskImpact          String?
  affectedTaskIds     String[]  @default([])
  analysedById        String?
  analysedAt          DateTime? @db.Timestamptz(3)

  // --- decision ----------------------------------------------------------
  approverId            String?
  decidedAt             DateTime? @db.Timestamptz(3)
  decisionNote          String?
  scheduleImpactApplied Boolean   @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase     Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  requester User    @relation("ChangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  analysedBy User?  @relation("ChangeAnalyst", fields: [analysedById], references: [id], onDelete: SetNull)
  approver  User?   @relation("ChangeApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@unique([projectId, reference])
  @@index([projectId, status])
}

// ===========================================================================
// Notifications
// ===========================================================================

model Notification {
  id         String           @id @default(cuid())
  userId     String
  projectId  String?
  taskId     String?
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  link       String?
  readAt     DateTime?        @db.Timestamptz(3)
  /// Idempotency handle: one row per (user, type, entity, day) for scheduled reminders.
  dedupeKey  String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  emails EmailNotification[]

  @@unique([dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// The outbox. A row reaches SENT only after the transport accepted the message; a
/// failure keeps the error so the UI never claims a delivery that did not happen.
model EmailNotification {
  id             String      @id @default(cuid())
  notificationId String?
  toEmail        String
  toUserId       String?
  subject        String
  template       String
  payload        Json
  status         EmailStatus @default(QUEUED)
  attempts       Int         @default(0)
  lastError      String?
  sentAt         DateTime?   @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model NotificationRule {
  id             String           @id @default(cuid())
  organizationId String
  type           NotificationType
  /// Days before the due date. 0 is "due today"; negative is days after (escalation).
  offsetDays     Int
  enabled        Boolean          @default(true)
  emailEnabled   Boolean          @default(true)
  notifyLead     Boolean          @default(false)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, offsetDays])
}

/// Records every scheduled job execution so a restart cannot make a job fire twice for
/// the same logical window (decision D-004).
model ScheduledJobRun {
  id         String    @id @default(cuid())
  jobName    String
  /// The logical window, e.g. "2026-09-27" for a daily job.
  runKey     String
  startedAt  DateTime  @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  succeeded  Boolean?
  error      String?
  stats      Json?

  @@unique([jobName, runKey])
  @@index([jobName, startedAt])
}

// ===========================================================================
// Audit, activity, import
// ===========================================================================

/// Append-only. No service exposes an update or delete path.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  projectId  String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  actor   User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([projectId, createdAt])
  @@index([actorId, createdAt])
}

model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String
  actorId    String?
  verb       String
  summary    String
  entityType String
  entityId   String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

/// A staged Excel import. Nothing reaches the project tables until the job is confirmed
/// (decision D-009).
model ImportJob {
  id          String          @id @default(cuid())
  projectId   String
  uploadedById String
  fileName    String
  checksum    String
  status      ImportJobStatus @default(PARSED)
  mapping     Json
  parsedRows  Json
  issues      Json
  summary     Json
  result      Json?
  error       String?
  confirmedAt DateTime?       @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

/// A request for time off (spec section 86). Approved leave marks the attendance days it
/// covers as LEAVE and is shown against the person's open tasks.
model LeaveRequest {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  type           LeaveType
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  /// Working days the request consumes, excluding weekends and holidays. Half days count 0.5.
  days           Decimal     @db.Decimal(5, 1)
  halfDay        Boolean     @default(false)
  reason         String?
  status         LeaveStatus @default(PENDING)
  approverId     String?
  decidedAt      DateTime?   @db.Timestamptz(3)
  decisionNote   String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  approver     User?        @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([userId, startDate])
}
