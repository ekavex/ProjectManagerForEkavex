{
  "name": "ekavist",
  "private": true,
  "version": "0.1.0",
  "description": "Ekavist — centralised project and team management platform",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @ekavist/api",
    "dev:web": "npm run dev --workspace @ekavist/web",
    "build": "npm run build --workspace @ekavist/shared && npm run build --workspace @ekavist/api && npm run build --workspace @ekavist/web",
    "build:shared": "npm run build --workspace @ekavist/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspace @ekavist/api",
    "test:integration": "npm run test:integration --workspace @ekavist/api",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @ekavist/api",
    "db:reset": "npm run db:reset --workspace @ekavist/api",
    "db:seed": "npm run db:seed --workspace @ekavist/api",
    "db:studio": "npm run db:studio --workspace @ekavist/api",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
