# ---------------------------------------------------------------------------
# Ekavist environment. Copy to .env and adjust. Never commit a filled-in .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API -------------------------------------------------------------------
API_PORT=4000
# Public origin of the SPA. Used for CORS and for links inside emails.
APP_URL=http://localhost:5173
# Public origin of the API, as the browser sees it.
API_URL=http://localhost:4000

# --- Database --------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 avoids clashing with a local Postgres.
DATABASE_URL=postgresql://ekavist:ekavist_dev_password@localhost:5433/ekavist?schema=public
TEST_DATABASE_URL=postgresql://ekavist:ekavist_dev_password@localhost:5433/ekavist_test?schema=public

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=change-me-to-a-long-random-string
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_PASSWORD_RESET_TTL_MINUTES=60
# Set to true behind HTTPS so the refresh cookie carries the Secure flag.
AUTH_COOKIE_SECURE=false

# --- Organisation defaults (applied by the installer, editable in the UI) ---
ORG_NAME=Ekavist
ORG_TIMEZONE=Asia/Kolkata
ORG_WORKDAY_START=09:30
ORG_LATE_AFTER=10:00

# --- Email -----------------------------------------------------------------
# smtp | json | console. "json" writes each message to logs/mail/ and never claims
# a message was delivered to a real inbox.
EMAIL_TRANSPORT=smtp
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Ekavist <no-reply@ekavist.local>"

# --- Background jobs -------------------------------------------------------
JOBS_ENABLED=true
# Cron expressions are evaluated in ORG_TIMEZONE.
JOBS_DEADLINE_SCAN_CRON=0 8 * * *
JOBS_OVERDUE_SCAN_CRON=15 8 * * *
JOBS_DAILY_SUMMARY_CRON=0 18 * * *
JOBS_WEEKLY_SUMMARY_CRON=0 9 * * 1
JOBS_CONSISTENCY_SCAN_CRON=0 2 * * *
JOBS_MAIL_DISPATCH_CRON=*/2 * * * *

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./uploads
UPLOAD_MAX_BYTES=10485760

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- Google Drive ----------------------------------------------------------
# Not used in v1: Drive resources are stored as links only (see docs/DECISIONS.md D-007).
# Populate these only when the Drive API integration is actually built.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web (Vite; only VITE_* reaches the browser) ---------------------------
VITE_API_URL=http://localhost:4000
